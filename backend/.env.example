# 飞书自定义机器人 Webhook URL（可选，仅在未配置应用机器人时作为回退）
TA_FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/your-token-here
# 应用机器人配置（推荐）
# 配置后系统会优先走应用机器人，不再走 webhook
TA_FEISHU_APP_ID=
TA_FEISHU_APP_SECRET=
TA_FEISHU_CHAT_ID=
# 飞书事件订阅签名密钥（可选；填写后将强制校验回调签名）
TA_FEISHU_EVENT_SIGNING_SECRET=
# 对外访问后端的公网地址（用于在飞书告警里拼接截图直链）
# 例如：https://your-topic-assistant.example.com
TA_PUBLIC_BASE_URL=
# 风控附件短时 token 配置（可选）
TA_RISK_ARTIFACT_TOKEN_SECRET=
TA_RISK_ARTIFACT_TOKEN_TTL_SECONDS=600
# 兼容期：允许 api_key 访问 /artifact 的天数（默认7天）
TA_RISK_ARTIFACT_LEGACY_API_KEY_DAYS=7

# API Key（用于保护接口，iOS 快捷指令和浏览器插件调用时需携带）
TA_API_KEY=changeme

# 抓取设置
TA_SCRAPE_HEADLESS=true
TA_SCRAPE_DELAY_MIN=2.0
TA_SCRAPE_DELAY_MAX=5.0
TA_SCRAPE_MAX_RESULTS=20
TA_SCRAPE_RETRY_ATTEMPTS=2

# 定时任务（每天几点执行，24小时制）
TA_SCHEDULE_ENABLED=true
TA_SCHEDULE_CRON_HOUR=9
TA_SCHEDULE_CRON_MINUTE=0

# 允许跨域访问的前端地址（逗号分隔）
TA_CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,http://localhost:5500,http://127.0.0.1:5500

# 生产环境建议（按需二选一）：
# 1) 仅允许你的前端域名（推荐）
# TA_CORS_ALLOW_ORIGINS=https://your-frontend-domain.vercel.app
# 2) 尚未固定前端域名时临时全开放
# TA_CORS_ALLOW_ORIGINS=*

# 生产环境建议把数据放到持久卷目录
# TA_DATA_DIR=/data
# TA_COOKIE_DIR=/data/cookies
# TA_DATABASE_URL=sqlite:////data/topic_assistant.db

# 云端部署时可通过环境变量注入小红书 Cookie（2 选 1）
# TA_XHS_COOKIES_JSON=[{"name":"...","value":"...","domain":".xiaohongshu.com",...}]
# TA_XHS_COOKIES_BASE64=base64后的Cookie JSON字符串
# 若目标文件已存在，默认不覆盖；要覆盖请设为 true
# TA_XHS_COOKIES_OVERWRITE=false

# 登录风控告警防刷屏冷却（秒）
# TA_RISK_ALERT_COOLDOWN_SECONDS=300

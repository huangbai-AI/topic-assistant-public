<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.topicassistant.tunnel</string>
  <key>ProgramArguments</key>
  <array>
    <string>__ROOT_DIR__/scripts/topic_tunnel_daemon.sh</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/topic_tunnel.launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/topic_tunnel.launchd.err.log</string>
</dict>
</plist>
